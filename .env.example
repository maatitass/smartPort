# Smart Port — Environment Configuration Template
# Copy to .env and fill in real credentials before running Docker Compose.

# --- Digitraffic Marine ---
DIGITRAFFIC_USER=smartport-lsdm-university-project
DIGITRAFFIC_MQTT_BROKER=meri.digitraffic.fi
DIGITRAFFIC_MQTT_PORT=443

# --- Kafka (KRaft) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=ais.locations.raw
KAFKA_TOPIC_ENRICHED=ais.locations.enriched
KAFKA_HEAP_OPTS=-Xms256m -Xmx384m

# --- Elasticsearch & Kibana Security ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD
KIBANA_SYSTEM_PASSWORD=CHANGE_ME_KIBANA_PASSWORD
ES_JAVA_OPTS=-Xms768m -Xmx768m
KIBANA_NODE_OPTIONS=--max-old-space-size=768

# --- Index Retention (ILM delete-only, days) ---
ES_EVENTS_RETENTION_DAYS=3
ES_DQ_RETENTION_DAYS=14
ES_AGG_RETENTION_DAYS=30

# --- Context Sync ---
VESSELS_SYNC_INTERVAL_MIN=60
WEATHER_SYNC_INTERVAL_MIN=60
REFERENCE_DATA_DIR=/data/reference
PINNED_VESSELS_SNAPSHOT=
PINNED_PORTS_SNAPSHOT=
PINNED_WEATHER_SNAPSHOT=

# --- Spark Cluster & Streaming ---
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=768m
SPARK_EXECUTOR_MEMORY=640m
SPARK_DRIVER_MEMORY=640m
SPARK_SHUFFLE_PARTITIONS=4
SPARK_WATERMARK_DELAY=2 minutes
SPARK_SILVER_TRIGGER=15 seconds
SPARK_GOLD_TRIGGER=30 seconds
SPARK_CHECKPOINT_DIR=/data/checkpoints
